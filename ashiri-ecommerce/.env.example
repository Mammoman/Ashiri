# ---- Browser (bundled into the client; must be safe to expose) ----
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-...

# ---- Server only (Vercel -> Settings -> Environment Variables; never VITE_-prefixed) ----
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>
FLUTTERWAVE_SECRET_KEY=FLWSECK-...
RESEND_API_KEY=re_...
# Optional
RESEND_FROM_EMAIL="Ashiri Orders <orders@contact.ashiri.store>"
MERCHANT_EMAIL=you@example.com
# Local development only: lets /api/create-order accept MOCK- payment references.
# Ignored automatically when VERCEL_ENV=production.
ALLOW_MOCK_PAYMENTS=false
